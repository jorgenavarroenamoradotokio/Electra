<?xml version="1.0" encoding="utf-8"?>
<!-- Carpetas que FileProvider puede compartir: logs (ver FileLoggingTree#resolveLogDir) y fotos -->
<paths>
    <external-files-path
        name="logs"
        path="logs/" />
    <files-path
        name="logs_internal"
        path="logs/" />
    <!-- Fotos que la app de cámara guarda para Electra (ver PhotoRepository) -->
    <cache-path
        name="photos"
        path="photos/" />
</paths>
