<?xml version="1.0" encoding="utf-8"?>
<!--
    Hoja de impresión: misma anatomía que el resto de hojas (icono, título, explicación, acciones y
    cancelar). La explicación cambia según el paso; el progreso, el aviso, la acción principal y la
    lista se muestran solo cuando aplican.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/spacing_l"
    tools:context=".ui.label.PrintLabelBottomSheet">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:layout_width="@dimen/icon_badge_size"
        android:layout_height="@dimen/icon_badge_size"
        android:background="@drawable/bg_icon_badge"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:src="@drawable/ic_print_24"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/print_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/text_print_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="@string/print_message_choose" />

    <!-- Buscando impresoras, generando la etiqueta o enviándola. TalkBack anuncia cada paso. -->
    <LinearLayout
        android:id="@+id/layout_print_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:accessibilityLiveRegion="polite"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_m"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            app:indicatorSize="@dimen/progress_indicator_size"
            app:trackThickness="@dimen/progress_indicator_thickness" />

        <TextView
            android:id="@+id/text_print_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="@string/print_searching" />

    </LinearLayout>

    <!-- Por qué falló el último intento y qué hacer; icono y texto, no solo color -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_print_notice"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"
        app:cardBackgroundColor="@color/msg_warning_bg"
        app:cardCornerRadius="@dimen/corner_radius_m"
        tools:visibility="visible">

        <TextView
            android:id="@+id/text_print_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_s"
            android:gravity="center_vertical"
            android:padding="@dimen/spacing_m"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/msg_warning_text"
            app:drawableStartCompat="@drawable/ic_error_24"
            app:drawableTint="@color/msg_warning_icon"
            tools:text="@string/error_printer_connection" />

    </com.google.android.material.card.MaterialCardView>

    <!-- "Permitir acceso" o "Activar Bluetooth": lo único que desbloquea el paso actual -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_print_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:minHeight="@dimen/button_height"
        android:visibility="gone"
        app:cornerRadius="@dimen/corner_radius_m"
        tools:text="@string/print_enable_bluetooth"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_printers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="2"
        tools:listitem="@layout/item_printer"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_printers_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_m"
        android:text="@string/print_no_printers"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_print_search_again"
        style="@style/Widget.Electra.Button.ListAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="@string/print_search_again"
        android:visibility="gone"
        app:icon="@drawable/ic_refresh_24"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_print_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:minHeight="@dimen/button_height"
        android:text="@string/label_options_cancel"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:cornerRadius="@dimen/corner_radius_m" />

</LinearLayout>
