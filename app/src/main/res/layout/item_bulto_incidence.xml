<?xml version="1.0" encoding="utf-8"?>
<!--
    Incidencia seleccionable, con la misma anatomía que el tipo de bulto: radio, código y, si la
    incidencia la exige, el aviso de foto. La fila completa es el objetivo táctil; el radio es
    decorativo y TalkBack lee la fila como un único elemento marcable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bulto_type_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_xs"
    android:paddingEnd="@dimen/spacing_m">

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/radio_bulto_incidence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/text_bulto_incidence_code"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="A23" />

    <!-- Solo en las incidencias que exigen foto: icono y texto, nunca solo color -->
    <LinearLayout
        android:id="@+id/layout_bulto_incidence_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_s"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="@dimen/icon_inline_size"
            android:layout_height="@dimen/icon_inline_size"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_photo_camera_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:text="@string/bulto_type_photo_required"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</LinearLayout>
