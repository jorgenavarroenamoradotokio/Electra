<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla principal: toolbar + fragment del destino actual, con el menú lateral a la izquierda.
    El menú: usuario conectado arriba, opciones de la sesión en el centro (desplazables) y
    cerrar sesión fijo abajo del todo. Los insets del sistema se aplican desde MainActivity.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/app_bar"
            layout="@layout/view_app_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:navGraph="@navigation/nav_graph" />

    </LinearLayout>

    <!-- clickable: los toques sobre huecos del panel no atraviesan al contenido de debajo -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical">

        <include
            android:id="@+id/drawer_header"
            layout="@layout/view_drawer_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Inicio fijo + menú de la sesión; las opciones con submenús se despliegan en el sitio -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_drawer_menu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/spacing_s"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_drawer_menu" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Mismo margen que las opciones del menú -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/drawer_item_inset"
            android:paddingVertical="@dimen/spacing_s">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_drawer_logout"
                style="@style/Widget.Electra.Button.ListAction.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/logout_confirm"
                app:icon="@drawable/ic_logout_24" />

        </FrameLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
