<?xml version="1.0" encoding="utf-8"?>
<!--
    Carga con precinto, en dos fases excluyentes:
    1. Precinto: se lee su CB o se teclea (8 dígitos) y se empieza la carga, la acción del pie.
    2. Lecturas: cabecera fija con el precinto y el tipo de bulto fijado, siempre a la vista; debajo
       el campo del escáner, la confirmación de la última lectura y la lista de bultos leídos. El
       tipo se fija o cambia tocando su ficha o la acción del pie, y se quita con la "x" de la ficha.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.carga.directa.DirectLoadFragment">

    <!-- Fase 1: precinto -->
    <LinearLayout
        android:id="@+id/layout_direct_load_seal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_m">

                <ImageView
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_badge"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_lock_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:text="@string/direct_load_seal_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center"
                    android:text="@string/direct_load_seal_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- El contador da progreso de lo tecleado sin esperar a validar -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_direct_load_seal_input"
                    style="?attr/textInputOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:hint="@string/direct_load_seal_hint"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_radius_m"
                    app:boxCornerRadiusBottomStart="@dimen/corner_radius_m"
                    app:boxCornerRadiusTopEnd="@dimen/corner_radius_m"
                    app:boxCornerRadiusTopStart="@dimen/corner_radius_m"
                    app:counterEnabled="true"
                    app:counterMaxLength="@integer/direct_load_seal_length"
                    app:helperText="@string/direct_load_seal_helper"
                    app:startIconContentDescription="@null"
                    app:startIconDrawable="@drawable/ic_lock_24">

                    <!--
                        Escáner o teclado: el escáner teclea el CB y termina con Intro, que
                        acepta el precinto igual que la acción del teclado. Sin límite de
                        longitud: un CB más largo se rechaza en lugar de recortarse en silencio.
                    -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_direct_load_seal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLines="1"
                        tools:text="12345678" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_m">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_direct_load_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:stateListAnimator="@animator/scale_on_press"
                android:text="@string/direct_load_start"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                app:cornerRadius="@dimen/corner_radius_m"
                app:icon="@drawable/ic_check_24"
                app:iconGravity="textStart" />

        </FrameLayout>

    </LinearLayout>

    <!-- Fase 2: lecturas de bultos -->
    <LinearLayout
        android:id="@+id/layout_direct_load_reading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Cabecera fija: precinto y tipo fijado siempre a la vista, aunque la lista crezca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/spacing_m">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_direct_load_seal"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="true"
                app:cardCornerRadius="@dimen/corner_radius_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:minHeight="@dimen/direct_load_header_min_height"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/direct_load_seal_label"
                        android:textAllCaps="true"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/text_direct_load_seal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        tools:text="12345678" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--
                Tipo fijado: toda la ficha abre el selector. Con tipo, tinte tonal y borde del color
                principal (como la fila elegida de la lista de tipos) y "x" para quitarlo; sin tipo,
                ficha neutra que invita a elegir. El estado se dice también con texto.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_direct_load_type"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/corner_radius_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/direct_load_header_min_height"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/spacing_s"
                    android:paddingStart="@dimen/spacing_m"
                    android:paddingEnd="@dimen/spacing_xs">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/direct_load_type_label"
                            android:textAllCaps="true"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/text_direct_load_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="C+" />

                        <TextView
                            android:id="@+id/text_direct_load_type_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="CONTENEDOR +" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/button_direct_load_type_clear"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/direct_load_type_clear"
                        android:src="@drawable/ic_close_24"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_direct_load_barcode"
            style="?attr/textInputOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
            android:layout_marginTop="@dimen/spacing_m"
            android:hint="@string/direct_load_barcode_hint"
            app:boxCornerRadiusBottomEnd="@dimen/corner_radius_m"
            app:boxCornerRadiusBottomStart="@dimen/corner_radius_m"
            app:boxCornerRadiusTopEnd="@dimen/corner_radius_m"
            app:boxCornerRadiusTopStart="@dimen/corner_radius_m"
            app:helperText="@string/direct_load_barcode_helper">

            <!-- Solo con el escáner, como en la puerta de salida: no se abre el teclado en pantalla -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_direct_load_barcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textCapCharacters"
                android:maxLines="1"
                tools:text="13020000062081000447204320001" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Confirmación de la última lectura: icono y texto, nunca solo color. TalkBack la anuncia
            para que el operario no tenga que mirar la pantalla en cada lectura.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_direct_load_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
            android:layout_marginTop="@dimen/spacing_s"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/corner_radius_s"
            app:cardElevation="0dp"
            tools:cardBackgroundColor="@color/msg_success_bg"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingVertical="@dimen/spacing_s">

                <ImageView
                    android:id="@+id/image_direct_load_feedback"
                    android:layout_width="@dimen/drawer_icon_size"
                    android:layout_height="@dimen/drawer_icon_size"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ic_check_24"
                    tools:tint="@color/msg_success_icon" />

                <TextView
                    android:id="@+id/text_direct_load_feedback"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Bulto leído con tipo C+"
                    tools:textColor="@color/msg_success_text" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/text_direct_load_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
            android:layout_marginTop="@dimen/spacing_m"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="3 bultos leídos" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_direct_load_readings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_s"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_direct_load_reading" />

            <!-- Sin lecturas todavía -->
            <LinearLayout
                android:id="@+id/layout_direct_load_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_badge"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_local_shipping_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:gravity="center"
                    android:text="@string/direct_load_empty_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center"
                    android:text="@string/direct_load_empty"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </FrameLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_m">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_direct_load_type"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                app:cornerRadius="@dimen/corner_radius_m"
                app:icon="@drawable/ic_local_shipping_24"
                app:iconGravity="textStart"
                tools:text="@string/direct_load_type_change" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
