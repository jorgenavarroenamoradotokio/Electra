<?xml version="1.0" encoding="utf-8"?>
<!--
    Carga con precinto, en dos fases excluyentes; cada una en su layout para poder previsualizarla:
    1. view_direct_load_seal: se pide el precinto.
    2. view_direct_load_reading: se leen los bultos con el precinto y el tipo fijado a la vista.
    El fragment muestra una u otra según el estado; aquí la vista previa enseña la de lecturas.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.carga.directa.DirectLoadFragment">

    <include
        android:id="@+id/layout_direct_load_seal"
        layout="@layout/view_direct_load_seal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <include
        android:id="@+id/layout_direct_load_reading"
        layout="@layout/view_direct_load_reading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
