<?xml version="1.0" encoding="utf-8"?>
<!--
    Estructura: franja de marca (crece para ocupar el espacio libre) + panel de formulario anclado abajo.
    Con el teclado abierto la franja se reduce a su contenido y el formulario sigue siendo desplazable.
    Los insets del sistema (status bar, navegación, teclado) se aplican desde LoginActivity.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.login.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Franja de marca: el contenido se apoya abajo, junto al panel, para leerse como una unidad -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/green_redur"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingBottom="@dimen/spacing_xl">

            <ImageView
                android:id="@+id/image_brand"
                android:layout_width="@dimen/login_brand_size"
                android:layout_height="@dimen/login_brand_size"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/text_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineLarge"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- Panel del formulario -->
        <LinearLayout
            android:id="@+id/container_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_panel_overlap"
            android:background="@drawable/bg_login_panel"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingBottom="@dimen/spacing_m">

            <TextView
                android:id="@+id/text_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/login_welcome"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/text_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/login_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Error de la petición: persistente junto al formulario (no efímero) y anunciado por TalkBack -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_login_error"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                app:cardBackgroundColor="@color/msg_error_bg"
                app:cardCornerRadius="@dimen/corner_radius_m"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/text_login_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/spacing_s"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_m"
                    tools:text="@string/error_network_503"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/msg_error_text"
                    app:drawableStartCompat="@drawable/ic_error_24"
                    app:drawableTint="@color/msg_error_icon" />

            </com.google.android.material.card.MaterialCardView>

            <!-- errorEnabled reserva desde el inicio la línea de error: al validar, el formulario no salta -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_username"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:hint="@string/login_username_hint"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_m"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_m"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_m"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_m"
                app:errorEnabled="true"
                app:startIconDrawable="@drawable/ic_person_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:imeOptions="actionNext"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_password"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:hint="@string/login_password_hint"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_m"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_m"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_m"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_m"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:startIconDrawable="@drawable/ic_lock_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Acción secundaria: enlace discreto bajo el campo al que se refiere -->
            <Button
                android:id="@+id/button_forgot_password"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/login_forgot_password" />

            <!-- El indicador se superpone al botón: la carga se comunica donde el usuario actuó -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:stateListAnimator="@animator/scale_on_press"
                    android:text="@string/login_button"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    app:cornerRadius="@dimen/corner_radius_m" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="@string/login_loading"
                    android:indeterminate="true"
                    android:visibility="invisible"
                    app:indicatorSize="@dimen/progress_indicator_size"
                    app:trackThickness="@dimen/progress_indicator_thickness" />

            </FrameLayout>

            <TextView
                android:id="@+id/text_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_l"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Versión 1.0.0" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
