<?xml version="1.0" encoding="utf-8"?>
<!--
    Carga de camión. La toolbar es la común (con "refrescar" añadido por la pantalla); debajo:
    1. Barra de la lista: ordenar, filtrar por vuelta y resumen de la carga a la izquierda; a la
       derecha las acciones sobre la expedición elegida (incidencia, información), deshabilitadas
       sin ninguna elegida.
    2. Progreso de la carga: cuántas expediciones están completas, en texto y en barra, y el filtro
       activo como etiqueta que se quita con su "x".
    3. Lista de expediciones, que alterna con cargando y error/vacío como en incidencias. Al
       refrescar con la lista a la vista, una barra fina arriba en lugar de vaciarla.
    4. Pie fijo: ver carga y finalizar, la principal, solo habilitada sin diferencias; mientras no
       lo está, una línea explica por qué.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.carga.camion.TruckLoadFragment">

    <!-- Barra de la lista: iconos con descripción y tooltip, 48dp de área táctil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/button_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_s">

        <ImageButton
            android:id="@+id/button_truck_load_sort"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/truck_load_sort"
            android:enabled="false"
            android:src="@drawable/ic_sort_24"
            android:tooltipText="@string/truck_load_sort"
            app:tint="@color/list_action_icon" />

        <ImageButton
            android:id="@+id/button_truck_load_filter"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/truck_load_filter_trip"
            android:enabled="false"
            android:src="@drawable/ic_local_shipping_24"
            android:tooltipText="@string/truck_load_filter_trip"
            app:tint="@color/list_action_icon" />

        <ImageButton
            android:id="@+id/button_truck_load_summary"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/truck_load_summary_title"
            android:enabled="false"
            android:src="@drawable/ic_summarize_24"
            android:tooltipText="@string/truck_load_summary_title"
            app:tint="@color/list_action_icon" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/button_truck_load_incidence"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/truck_load_incidence"
            android:enabled="false"
            android:src="@drawable/ic_report_problem_24"
            android:tooltipText="@string/truck_load_incidence"
            app:tint="@color/list_action_icon" />

        <ImageButton
            android:id="@+id/button_truck_load_info"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/truck_load_info"
            android:enabled="false"
            android:src="@drawable/ic_info_24"
            android:tooltipText="@string/truck_load_info"
            app:tint="@color/list_action_icon" />

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layout_truck_load_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Progreso de la carga: el texto es la fuente, la barra solo lo acompaña -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/spacing_s">

                <TextView
                    android:id="@+id/text_truck_load_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="2 de 6 expediciones completas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_truck_load_filter"
                    style="@style/Widget.Material3.Chip.Input"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:checkable="false"
                    android:visibility="gone"
                    app:chipIcon="@drawable/ic_local_shipping_24"
                    app:chipIconTint="?attr/colorPrimary"
                    app:chipIconVisible="true"
                    app:closeIconVisible="true"
                    tools:text="Vuelta 2"
                    tools:visibility="visible" />

            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_truck_load_complete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/spacing_xs"
                android:importantForAccessibility="no"
                android:max="100"
                app:trackCornerRadius="@dimen/truck_load_progress_thickness"
                app:trackThickness="@dimen/truck_load_progress_thickness"
                tools:progress="33" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_s"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_truck_load_expeditions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/spacing_m"
                    android:paddingBottom="@dimen/spacing_s"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_truck_load_expedition" />

                <!-- Refresco con la lista a la vista: la lista no se vacía mientras llega la nueva -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_truck_load_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:indeterminate="true"
                    android:visibility="invisible"
                    app:hideAnimationBehavior="outward"
                    app:showAnimationBehavior="inward" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_truck_load_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:gravity="center"
                android:text="@string/truck_load_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Error y carga vacía comparten anatomía: qué ha pasado y cómo seguir -->
        <LinearLayout
            android:id="@+id/layout_truck_load_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image_truck_load_message"
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_badge"
                android:importantForAccessibility="no"
                android:scaleType="center"
                tools:src="@drawable/ic_local_shipping_24"
                tools:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/text_truck_load_message_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="@string/truck_load_empty_title" />

            <TextView
                android:id="@+id/text_truck_load_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="@string/truck_load_empty" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_truck_load_message_action"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:minHeight="@dimen/button_height"
                app:cornerRadius="@dimen/corner_radius_m"
                app:icon="@drawable/ic_refresh_24"
                tools:text="@string/truck_load_refresh" />

        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/layout_truck_load_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <!-- Finalizar deshabilitado no explica por sí solo qué falta -->
        <TextView
            android:id="@+id/text_truck_load_finish_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_s"
            android:gravity="center"
            android:text="@string/truck_load_finish_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_truck_load_view"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="@dimen/button_height"
                android:text="@string/truck_load_view"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                app:cornerRadius="@dimen/corner_radius_m"
                app:icon="@drawable/ic_visibility_24"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_truck_load_finish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="@dimen/button_height"
                android:stateListAnimator="@animator/scale_on_press"
                android:text="@string/truck_load_finish"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                app:cornerRadius="@dimen/corner_radius_m"
                app:icon="@drawable/ic_check_24"
                app:iconGravity="textStart" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
