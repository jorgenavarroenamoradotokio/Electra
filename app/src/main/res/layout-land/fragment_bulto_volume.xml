<?xml version="1.0" encoding="utf-8"?>
<!--
    Lectura en modo Volumen en horizontal: la lectura (CB, medidas en una fila y volumen) ocupa la
    derecha, a toda la altura, para que el campo que se espera quede a la vista. El panel lateral
    reúne las acciones rápidas, los datos a recoger y, al pie, las acciones como en vertical:
    cancelar a la izquierda y aceptar, la principal, a la derecha. Mismos ids y reglas que en vertical.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    tools:context=".ui.bulto.volumen.BultoVolumeFragment">

    <LinearLayout
        android:layout_width="@dimen/side_pane_width"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_m">

                <!-- Acciones rápidas de la lectura -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_bulto_volume_ps"
                        style="@style/Widget.Electra.Button.ReadingAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bulto_volume_action_ps" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_bulto_volume_tb"
                        style="@style/Widget.Electra.Button.ReadingAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/bulto_volume_action_tb" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_bulto_volume_kg"
                        style="@style/Widget.Electra.Button.ReadingAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/bulto_volume_action_kg" />

                    <!-- Incidencia: en color de error para distinguirla de un vistazo -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_bulto_volume_inc"
                        style="@style/Widget.Electra.Button.ReadingAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/bulto_volume_action_inc"
                        android:textColor="?attr/colorError" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:accessibilityHeading="true"
                    android:text="@string/bulto_volume_collected_title"
                    android:textAllCaps="true"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Solo el modo Volumen está disponible en esta pantalla; el resto se muestra desactivado -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_bulto_volume_cubicar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:enabled="false"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/bulto_volume_check_cubicar"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_bulto_volume_previous"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/bulto_volume_check_previous"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_bulto_volume_full_expedition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/bulto_volume_check_full_expedition"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_bulto_volume_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/bulto_volume_check_volume"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_m">

            <!-- TalkBack recorre la lectura antes que las acciones, como en vertical -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_bulto_volume_cancel"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityTraversalAfter="@id/layout_bulto_volume_result"
                android:minHeight="@dimen/button_height"
                android:text="@string/bulto_volume_cancel"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                app:cornerRadius="@dimen/corner_radius_m"
                app:icon="@drawable/ic_close_24"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_bulto_volume_confirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_weight="1"
                android:accessibilityTraversalAfter="@id/button_bulto_volume_cancel"
                android:minHeight="@dimen/button_height"
                android:stateListAnimator="@animator/scale_on_press"
                android:text="@string/bulto_volume_confirm"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                app:cornerRadius="@dimen/corner_radius_m"
                app:icon="@drawable/ic_check_24"
                app:iconGravity="textStart" />

        </LinearLayout>

    </LinearLayout>

    <View style="@style/Widget.Electra.Divider.Vertical" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- Lectura del modo Volumen: CB y medidas en el orden en que se esperan -->
        <LinearLayout
            android:id="@+id/container_bulto_volume_reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingVertical="@dimen/spacing_m">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_bulto_volume_barcode"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bulto_volume_barcode_hint"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_m"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_m"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_m"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_m"
                app:errorEnabled="true"
                app:helperText="@string/bulto_volume_barcode_helper">

                <!-- Los escáneres terminan la lectura con Intro: pasa al alto -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_bulto_volume_barcode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions|textCapCharacters"
                    android:maxLines="1"
                    tools:text="14600400072459116400016247001" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Medidas de 3 dígitos: en una fila, como en peso, para que el volumen quede a la vista -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_bulto_volume_height"
                    style="?attr/textInputOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/bulto_volume_height_hint"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_radius_m"
                    app:boxCornerRadiusBottomStart="@dimen/corner_radius_m"
                    app:boxCornerRadiusTopEnd="@dimen/corner_radius_m"
                    app:boxCornerRadiusTopStart="@dimen/corner_radius_m">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_bulto_volume_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="@integer/bulto_measure_max_length"
                        android:maxLines="1"
                        tools:text="040" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_bulto_volume_width"
                    style="?attr/textInputOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1"
                    android:hint="@string/bulto_volume_width_hint"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_radius_m"
                    app:boxCornerRadiusBottomStart="@dimen/corner_radius_m"
                    app:boxCornerRadiusTopEnd="@dimen/corner_radius_m"
                    app:boxCornerRadiusTopStart="@dimen/corner_radius_m">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_bulto_volume_width"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="@integer/bulto_measure_max_length"
                        android:maxLines="1"
                        tools:text="030" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_bulto_volume_depth"
                    style="?attr/textInputOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1"
                    android:hint="@string/bulto_volume_depth_hint"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_radius_m"
                    app:boxCornerRadiusBottomStart="@dimen/corner_radius_m"
                    app:boxCornerRadiusTopEnd="@dimen/corner_radius_m"
                    app:boxCornerRadiusTopStart="@dimen/corner_radius_m">

                    <!-- La última medida acepta la lectura desde el teclado -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_bulto_volume_depth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="@integer/bulto_measure_max_length"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!--
                Calculado, no editable: estilo relleno para distinguirlo de los campos que se
                leen. Sigue siendo legible por TalkBack, pero no recibe foco ni teclado.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_bulto_volume_result"
                style="?attr/textInputFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:hint="@string/bulto_volume_volume_hint"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_m"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_m"
                app:errorEnabled="true"
                app:helperText="@string/bulto_volume_volume_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_bulto_volume_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:longClickable="false"
                    android:maxLines="1"
                    tools:text="0,04" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
