<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Espaciado -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">8dp</dimen>
    <dimen name="spacing_m">16dp</dimen>
    <dimen name="spacing_l">24dp</dimen>
    <dimen name="spacing_xl">40dp</dimen>

    <!-- Pantalla -->
    <dimen name="screen_padding_horizontal">24dp</dimen>
    <dimen name="screen_padding_vertical">32dp</dimen>

    <!-- Componentes -->
    <dimen name="touch_target_min">48dp</dimen>
    <dimen name="button_height">56dp</dimen>
    <dimen name="corner_radius_s">8dp</dimen>
    <dimen name="corner_radius_m">12dp</dimen>
    <dimen name="corner_radius_xl">28dp</dimen>
    <dimen name="progress_indicator_size">24dp</dimen>
    <dimen name="progress_indicator_thickness">3dp</dimen>
    <dimen name="icon_badge_size">56dp</dimen>
    <dimen name="icon_badge_size_s">40dp</dimen>
    <!-- Borde que marca el elemento elegido de una lista de selección -->
    <dimen name="selection_stroke_width">2dp</dimen>
    <dimen name="icon_inline_size">16dp</dimen>
    <dimen name="fab_elevation">6dp</dimen>
    <!-- Puerta de salida: el muelle se lee a distancia -->
    <dimen name="bulto_dock_code_height">112dp</dimen>
    <dimen name="bulto_dock_code_text_max">88sp</dimen>
    <dimen name="bulto_dock_code_text_min">32sp</dimen>
    <!-- Hueco bajo el contenido para que el botón de cámara no tape el último elemento: alto + márgenes -->
    <dimen name="bulto_dock_fab_clearance">88dp</dimen>
    <!-- Carga con precinto: fichas de precinto y tipo de bulto de la cabecera -->
    <dimen name="direct_load_header_min_height">72dp</dimen>
    <!-- Carga de camión: etiquetas compactas de la expedición y barra de progreso de la carga -->
    <dimen name="tag_min_height">28dp</dimen>
    <dimen name="truck_load_progress_thickness">6dp</dimen>
    <!-- Del borde de una fila ListAction al inicio de su texto: padding + icono + separación -->
    <dimen name="list_action_text_inset">56dp</dimen>
    <!--
        Horizontal (layout-land): panel lateral con el contexto y las acciones de la pantalla; la
        lista o el formulario ocupan el resto y toda la altura, que es lo que escasea.
    -->
    <dimen name="side_pane_width">300dp</dimen>
    <dimen name="divider_thickness">1dp</dimen>
    <!--
        Solo en horizontal (values-land/styles.xml). Más alta que cualquier pantalla: la hoja inferior
        se abre entera; con la altura automática Material la deja casi plegada (reserva el alto de
        una proporción 16:9).
    -->
    <dimen name="bottom_sheet_peek_height">2000dp</dimen>

    <!-- Menú lateral -->
    <dimen name="drawer_width">304dp</dimen>
    <!-- Separación de cada opción (y de su fondo activo) con los bordes del menú -->
    <dimen name="drawer_item_inset">12dp</dimen>
    <!-- Inicio del icono de las opciones: drawer_item_inset + spacing_m (padding de la opción) -->
    <dimen name="drawer_content_inset">28dp</dimen>
    <!-- Separación vertical entre opciones: las píldoras activas no se tocan -->
    <dimen name="drawer_item_spacing">2dp</dimen>
    <dimen name="drawer_icon_size">24dp</dimen>
    <!-- Sangría por nivel de submenú: icono + separación, el hijo arranca bajo el texto del padre -->
    <dimen name="drawer_level_indent">40dp</dimen>
    <dimen name="drawer_avatar_size">40dp</dimen>

    <!-- Perfil: avatar protagonista de la franja de marca -->
    <dimen name="profile_avatar_size">64dp</dimen>

    <!-- Login -->
    <dimen name="login_brand_size">56dp</dimen>
    <!-- El panel se solapa con la franja de marca lo mismo que mide su radio -->
    <dimen name="login_panel_overlap">-28dp</dimen>
</resources>
