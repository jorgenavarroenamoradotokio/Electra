<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Toolbar de la app: franja de marca, igual que la status bar y la cabecera del login.
        El fondo lo pinta el contenedor (view_app_toolbar) para cubrir también la status bar.
    -->
    <style name="Widget.Electra.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/toolbar_subtitle</item>
        <item name="navigationIconTint">@color/white</item>
        <!-- Iconos del menú y del desplegable ("⋮") en claro sobre el fondo oscuro -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
        <!-- El menú desplegable sigue el tema claro/oscuro de la app, no el de la franja -->
        <item name="popupTheme">@style/Theme.Electra</item>
    </style>

    <!--
        Fila de acción a todo el ancho (icono + texto alineados al inicio), para listas de opciones
        como las del perfil. Neutra por defecto; la variante Destructive se reserva para salir/borrar.
    -->
    <style name="Widget.Electra.Button.ListAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">@dimen/spacing_m</item>
        <item name="android:paddingEnd">@dimen/spacing_m</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/list_action_content</item>
        <item name="iconTint">@color/list_action_icon</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">@dimen/spacing_m</item>
        <item name="cornerRadius">@dimen/corner_radius_m</item>
    </style>

    <style name="Widget.Electra.Button.ListAction.Destructive">
        <item name="android:textColor">@color/list_action_destructive</item>
        <item name="iconTint">@color/list_action_destructive</item>
    </style>

    <!--
        Acción rápida de la lectura de un bulto (PS, TB, KG, INC): caben en una fila, así
        que se quitan el ancho mínimo y el padding lateral del botón estándar.
    -->
    <style name="Widget.Electra.Button.ReadingAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/spacing_xs</item>
        <item name="android:paddingEnd">@dimen/spacing_xs</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="cornerRadius">@dimen/corner_radius_s</item>
    </style>

    <!--
        Etiqueta informativa de una expedición (vuelta, tipo, instrucciones, avisos): no se pulsa,
        así que no reserva área táctil. Tinte tonal del color principal, como la etiqueta de tipo
        de bulto; los avisos cambian a los colores de warning desde el adapter.
    -->
    <style name="Widget.Electra.Chip.Tag" parent="Widget.Material3.Chip.Assist">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipMinHeight">@dimen/tag_min_height</item>
        <item name="chipBackgroundColor">@color/icon_badge_background</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/corner_radius_s</item>
        <item name="chipIconSize">@dimen/icon_inline_size</item>
        <item name="chipIconTint">?attr/colorPrimary</item>
        <item name="chipStartPadding">@dimen/spacing_xs</item>
        <item name="chipEndPadding">@dimen/spacing_xs</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>
</resources>
