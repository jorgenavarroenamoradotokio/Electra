<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Electra" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Sobre fondo oscuro, green_redur apenas contrasta: se usa la variante clara -->
        <item name="colorPrimary">@color/green_redur_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/green_redur</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
